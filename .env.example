# The Movie Database (TMDB) API Keys
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_bearer_token_here

# Automated Cron Security Key (for triggering /api/cron-generate)
CRON_SECRET=generate_a_random_32_char_secret_here

# Monetized Editorial Destination URL (Where the Ending Explained CTA directs users)
NEXT_PUBLIC_EDITORIAL_SITE_URL=https://your-editorial-adsense-site.com

# Amazon Bedrock Credentials (Used when running outside an IAM Role on AWS Amplify)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Site URL for dynamic canonical and sitemap generation
NEXT_PUBLIC_SITE_URL=https://your-hub-domain.com
